# Closed 1.0 m x 3.5 m x 0.6 m ramp wedge.
# +Y is the low end; -Y is the high end adjoining the Transfer Area.
v -0.500000 -1.750000 0.000000
v  0.500000 -1.750000 0.000000
v -0.500000  1.750000 0.000000
v  0.500000  1.750000 0.000000
v -0.500000 -1.750000 0.600000
v  0.500000 -1.750000 0.600000

vn  0.000000  0.000000 -1.000000
vn  0.000000  0.168964  0.985622
vn  0.000000 -1.000000  0.000000
vn -1.000000  0.000000  0.000000
vn  1.000000  0.000000  0.000000

# Bottom
f 1//1 4//1 2//1
f 1//1 3//1 4//1
# Sloped top
f 5//2 4//2 3//2
f 5//2 6//2 4//2
# High vertical end
f 1//3 6//3 5//3
f 1//3 2//3 6//3
# Negative-X side
f 1//4 5//4 3//4
# Positive-X side
f 2//5 4//5 6//5
